{
  "name": "@mongars/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "npm run start:dev-client",
    "start:lan": "npm run start:dev-client:lan",
    "start:dev-client": "expo start --dev-client",
    "start:dev-client:lan": "expo start --dev-client --lan",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "build:development": "npx --yes eas-cli@21.0.3 build --profile development",
    "build:development:ios": "npx --yes eas-cli@21.0.3 build --platform ios --profile development",
    "lint": "expo lint",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "57.0.8",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-worklets": "0.10.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "9.39.1",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "eslint-config-expo": {
      "eslint-import-resolver-typescript": "^4.4.5"
    },
    "postcss": "^8.5.19",
    "uuid": "^11.1.1"
  },
  "private": true
}
